{
    "name": "bot_ts",
    "version": "1.0.0",
    "description": "Template de bot Discord em TypeScript. Inclui Licença MIT (ver LICENSE.md).",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start:dev": "tsx src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "kevinkvn_",
    "license": "MIT",
    "dependencies": {
        "discord.js": "^14",
        "dotenv": "^16",
        "zod": "^3"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@types/node": "^22",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "prettier": "^3",
        "tsx": "^4",
        "typescript": "^5",
        "typescript-eslint": "^8",
        "vitest": "^5.0.2"
    }
}
